HIGHWAY_STORAGE_MODE=s3_async
HIGHWAY_BIND=127.0.0.1
HIGHWAY_PORT=4000
HIGHWAY_ORIGIN=https://app.example.com
HIGHWAY_JWKS_FILE=/etc/highway/public-jwks.json
HIGHWAY_JWT_ISSUER=https://app.example.com
HIGHWAY_JWT_AUDIENCE=highway
HIGHWAY_S3_BUCKET=REPLACE_BUCKET
HIGHWAY_S3_PREFIX=REPLACE_PREFIX
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID_FILE=/run/secrets/aws_access_key_id
AWS_SECRET_ACCESS_KEY_FILE=/run/secrets/aws_secret_access_key
# AWS_SESSION_TOKEN_FILE=/run/secrets/aws_session_token
HIGHWAY_DRAIN_MS=30000
HIGHWAY_PROBE_MS=5000
HIGHWAY_PROBE_STALE_MS=15000
